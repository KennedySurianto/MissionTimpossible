# Ignore binaries and intermediate files
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Ignore project-specific cache files
*.sln
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Ignore files generated by Unreal Engine
.vscode/
.vs/
*.xcodeproj
*.xcworkspace

# Ignore temporary and system files
*.tmp
*.log
*.obj
*.pch
*.pdb
*.exe
*.dll
*.app
*.dSYM
*.ipa
*.so
*.dylib
*.ds_store
Thumbs.db

# Ignore any auto-generated asset files
*.uasset
*.umap

# Unreal Engine user-specific settings (optional, if you don’t need per-user settings in source control)
Config/DefaultEditor.ini
Config/DefaultEditorLayout.ini
Config/DefaultEditorKeyBindings.ini
Config/DefaultEngine.ini
Config/DefaultInput.ini
Config/DefaultGame.ini
